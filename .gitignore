# Data and images are never committed (SCIN images stay in the bucket)
data/raw/
data/processed/
*.png.part
*.jpg.part

# Archives downloaded from Kaggle/Colab (unzip, then delete)
*.zip

# Run logs: keep only summaries
runs/*
!runs/README.md
!runs/summaries/

# Model weights (the final model is saved under models/)
models/
*.pt
*.pth
*.ckpt

# Python / tooling
.venv/
__pycache__/
*.pyc
.pytest_cache/
.ipynb_checkpoints/
.DS_Store

# Case-level predictions (one row per SCIN case) stay out of git
reports/predictions/

# Grad-CAM grids show SCIN photos: never committed (README: no SCIN images in this repo)
reports/gradcam/
